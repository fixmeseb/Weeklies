# Copy to .env (git-ignored) and fill in. `flask run` loads .env automatically.

# Signs session cookies. Use a long random value and keep it out of git:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Optional for local development: if unset, the app generates a key on first run
# and saves it to proj2/instance/secret_key (git-ignored). Set it on any shared server.
WEEKLIES_SECRET_KEY=

# Uncomment for auto-reload and the interactive debugger during local development.
# Never enable on a server others can reach.
# FLASK_DEBUG=1

# SQLite database. Defaults to proj2/CSC510_DB.db. Used by the app and the scripts.
# Note: proj2/scripts/cypress_seed.py drops and recreates every table in this DB.
# WEEKLIES_DB_PATH=

# Hugging Face model for meal generation. Defaults to ibm-granite/granite-4.0-h-350M.
# WEEKLIES_LLM_MODEL=

# Password for accounts the seed scripts in scripts/ create or reset. If unset, each run
# generates a random one and prints it. (Cypress fixtures keep their own test password.)
# WEEKLIES_SEED_PASSWORD=
